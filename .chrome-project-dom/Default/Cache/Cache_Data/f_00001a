	const [historialSnap, licitacionesSnap, cotizacionesSnap] = await Promise.all([
		getDocs(historialQuery),
		getDocs(collection(db, "licitaciones")),
		getDocs(query(collection(db, "cotizaciones"), where("proveedorId", "==", proveedorId)))
	]);
