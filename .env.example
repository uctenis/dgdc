# Cliente OAuth 2.0 de tipo "Aplicación web" creado en Google Cloud.
# Agregue http://localhost:5180 como origen JavaScript autorizado para desarrollo.
VITE_GOOGLE_DRIVE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# URL HTTPS de la función `adobeSignApi` desplegada en Firebase Functions.
# Ejemplo: https://us-central1-mi-proyecto.cloudfunctions.net/adobeSignApi
VITE_ADOBE_SIGN_API_URL=

# Función HTTPS que valida con Firebase Auth la firma de estados de pago.
VITE_PAYMENT_SIGNATURE_URL=https://us-central1-dgdc-c848d.cloudfunctions.net/firmarEstadoPago

# Función HTTPS que envía las invitaciones de licitación por correo real (Gmail/Workspace).
# Requiere los secretos GMAIL_USER y GMAIL_APP_PASSWORD configurados en Firebase Functions.
VITE_INVITACIONES_LICITACION_URL=https://us-central1-dgdc-c848d.cloudfunctions.net/enviarInvitacionesLicitacion

# Envío real de correos a proveedores. Déjalo sin definir (o en false) durante las pruebas: el sistema
# simula el envío y NO manda ningún correo. Pon true solo al lanzar el sistema en producción.
# VITE_ENVIO_CORREOS_REAL=true

# Habilita las funciones de IA (reescritura de descripciones, sugerencia de itemizado por partidas).
# Si se configura VITE_GEMINI_API_KEY, se usa Gemini (tiene nivel gratuito real en
# aistudio.google.com/apikey, sin tarjeta de crédito); si no, se usa OpenAI como respaldo.
# ADVERTENCIA: la key se incluye en el bundle del cliente (prefijo VITE_) y queda visible en el
# navegador — válida solo para pruebas. Antes de producción, migrar estas llamadas a una Firebase
# Function (como VITE_PAYMENT_SIGNATURE_URL) para no exponer la API key.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash
# "vertex" si la key se creó en Google Cloud (Vertex AI modo express, con "Bound account");
# vacío si se creó en aistudio.google.com.
VITE_GEMINI_PROVEEDOR=

VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
