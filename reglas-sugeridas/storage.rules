rules_version = '2';

// REGLAS SUGERIDAS — no están desplegadas. Léase LEEME.md antes de aplicarlas.
service firebase.storage {
  match /b/{bucket}/o {

    function esInterno() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@uct[.]cl');
    }

    function miProveedorId() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.proveedorId;
    }

    // Proveedor con sesión que figura como invitado de la licitación.
    function proveedorInvitado(licId) {
      return request.auth != null && !esInterno()
        && firestore.exists(/databases/(default)/documents/licitaciones/$(licId)/invitados/$(miProveedorId()));
    }

    // Ofertas: cada proveedor solo sube y lee dentro de SU carpeta (no puede listar ni ver las de otros).
    match /licitaciones/{licId}/ofertas/{provId}/{archivo=**} {
      // Sello de ofertas DESACTIVADO (2026-09-30). Para activarlo, cambiar esInterno() por:
      //   (esInterno() && request.time.toMillis() > firestore.get(/databases/(default)/documents/licitaciones/$(licId)).data.get('limiteOfertasMs', 0))
      allow get: if esInterno()
        || (proveedorInvitado(licId) && provId == miProveedorId());
      // Solo se puede subir hasta la hora de cierre (reloj del servidor).
      allow create: if esInterno()
        || (proveedorInvitado(licId) && provId == miProveedorId()
            && request.time.toMillis() <= firestore.get(/databases/(default)/documents/licitaciones/$(licId)).data.get('limiteOfertasMs', 9999999999999));
      allow list, update, delete: if esInterno();
    }

    // Todo lo demás: solo personal interno. Los documentos de antecedentes se entregan al proveedor mediante
    // los enlaces de descarga que ya guarda la licitación.
    // Requisitos de la inscripción de proveedores: se suben con el enlace personal mientras la inscripción está
    // abierta (PDF o imagen, hasta 15 MB). Se descargan con el enlace de descarga que guarda la inscripción.
    match /inscripciones/{codigo}/{archivo} {
      allow create: if firestore.get(/databases/(default)/documents/inscripcionesProveedores/$(codigo)).data.estado in ['Invitada', 'Observada']
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
      allow get: if esInterno()
        || firestore.get(/databases/(default)/documents/inscripcionesProveedores/$(codigo)).data.estado in ['Invitada', 'Observada'];
      allow list, update, delete: if esInterno();
    }

    // (Sin comodín sobre las ofertas: en Firebase basta que UNA regla permita, y abriría las ofertas selladas.)
    match /licitaciones/{licId}/{categoria}/{archivo=**} {
      allow read, write: if esInterno() && categoria != 'ofertas';
    }
    match /{carpeta}/{todo=**} {
      allow read, write: if esInterno() && carpeta != 'licitaciones' && carpeta != 'inscripciones';
    }
  }
}
