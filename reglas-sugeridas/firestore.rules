rules_version = '2';

// REGLAS SUGERIDAS — no están desplegadas. Léase LEEME.md antes de aplicarlas.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }

    // Personal institucional: cuenta Google verificada del dominio uct.cl.
    function esInterno() {
      return autenticado()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@uct[.]cl');
    }

    function perfilExiste() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esProveedor() {
      return autenticado() && !esInterno() && perfilExiste() && perfil().role == 'proveedor';
    }
    function miProveedorId() { return perfil().proveedorId; }

    // El portal cierra a la hora: `limiteOfertasMs` lo calcula la app al guardar la licitación (fecha + hora, hora de Chile).
    // Se compara con el reloj del SERVIDOR, no con el del navegador.
    function dentroDePlazo(licId) {
      return request.time.toMillis() <= get(/databases/$(database)/documents/licitaciones/$(licId)).data.get('limiteOfertasMs', 9999999999999);
    }

    // Ofertas selladas (hoy DESACTIVADO; ver match /propuestas): el personal interno solo leería las propuestas después de la hora de cierre
    // (sin hora de cierre definida, no hay sello). Nota: en la prueba local "Probar como este proveedor"
    // se usa la sesión interna, así que con esta regla esa prueba no puede releer su oferta antes del cierre.
    function ofertasAbiertas(licId) {
      return request.time.toMillis() > get(/databases/$(database)/documents/licitaciones/$(licId)).data.get('limiteOfertasMs', 0);
    }

    // El proveedor solo ve una licitación si figura entre sus invitados.
    function invitadoALicitacion(licId) {
      return esProveedor()
        && exists(/databases/$(database)/documents/licitaciones/$(licId)/invitados/$(miProveedorId()));
    }

    // ── Configuración compartida (campus/edificios, nómina, catálogos, plantillas) ──
    // La lee todo el personal UCT (se necesita para validar la nómina al entrar); solo el
    // administrador del sistema la modifica.
    match /configuracion/{clave} {
      allow read: if esInterno();
      allow write: if esInterno() && request.auth.token.email.lower() == 'dsilva@uct.cl';
    }

    // ── Perfiles ───────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if esInterno() || (autenticado() && request.auth.uid == uid);

      // Un proveedor solo puede crear SU perfil, y solo vinculado a la empresa de un enlace de invitación
      // real cuyo correo coincide con el de su cuenta. No puede darse otro rol ni otra empresa.
      allow create: if esInterno()
        || (autenticado() && request.auth.uid == uid
            && request.resource.data.role == 'proveedor'
            && request.resource.data.tokenInvitacion is string
            && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.tokenInvitacion))
            && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.tokenInvitacion)).data.proveedorId
                 == request.resource.data.proveedorId
            && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.tokenInvitacion)).data.proveedorEmail.lower()
                 == request.auth.token.email.lower());

      allow update: if esInterno()
        || (autenticado() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('proveedorId', null) == resource.data.get('proveedorId', null)
            && request.resource.data.get('tokenInvitacion', null) == resource.data.get('tokenInvitacion', null));

      allow delete: if esInterno();
    }

    // ── Enlaces personales de invitación ───────────────────────────────────
    // Solo se pueden leer conociendo el código; nadie puede listarlos.
    match /invitaciones/{token} {
      allow get: if autenticado();
      allow list: if false;
      allow write: if esInterno();
    }

    // ── Licitaciones ───────────────────────────────────────────────────────
    match /licitaciones/{licId} {
      allow read: if esInterno() || invitadoALicitacion(licId);
      allow create, delete: if esInterno();

      // El proveedor adjudicado solo puede solicitar la recepción conforme; nada más.
      allow update: if esInterno()
        || (invitadoALicitacion(licId)
            && resource.data.get('proveedorGanadorId', '') == miProveedorId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recepcionConforme', 'estadoLifecycle', '_updatedAt']));

      // Un proveedor solo ve SU invitación; no la lista de invitados ni sus códigos.
      match /invitados/{provId} {
        allow read: if esInterno() || (esProveedor() && provId == miProveedorId());
        allow create, delete: if esInterno();
        allow update: if esInterno()
          || (esProveedor() && provId == miProveedorId()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['estadoPropuesta', 'fechaPresentacion', 'primerAcceso', 'ultimoAcceso', 'cantidadAccesos', 'aclaracionesVistas']));
      }

      // Consultas: el proveedor invitado solo crea y lee LAS SUYAS (antes del cierre del portal) y no puede
      // responderlas ni modificarlas. Responder es del personal interno.
      match /consultas/{consultaId} {
        allow read: if esInterno() || (esProveedor() && resource.data.proveedorId == miProveedorId());
        allow create: if esInterno()
          || (invitadoALicitacion(licId)
              && request.resource.data.proveedorId == miProveedorId()
              && request.resource.data.proveedorUid == request.auth.uid
              && request.resource.data.estado == 'Pendiente'
              && request.resource.data.keys().hasOnly(['proveedorId', 'proveedorNombre', 'proveedorUid', 'pregunta', 'fechaPregunta', 'estado', '_createdAt'])
              && request.resource.data.pregunta is string && request.resource.data.pregunta.size() <= 2000
              && dentroDePlazo(licId));
        allow update, delete: if esInterno();
      }

      // Aclaraciones y modificaciones a las bases: las publica la UCT y las leen todos los invitados.
      match /aclaraciones/{aclaracionId} {
        allow read: if esInterno() || invitadoALicitacion(licId);
        allow write: if esInterno();
      }

      // Respuestas publicadas (sin identificar a quién preguntó): las leen todos los invitados.
      match /consultasPublicadas/{consultaId} {
        allow read: if esInterno() || invitadoALicitacion(licId);
        allow write: if esInterno();
      }

      // Cada proveedor solo lee y escribe SU propuesta, y no puede modificarla una vez enviada
      // (salvo dejar constancia de la confirmación por correo).
      match /propuestas/{provId} {
        // Sello de ofertas DESACTIVADO (2026-09-30). Para activarlo: esInterno() && ofertasAbiertas(licId).
        allow read: if esInterno() || (esProveedor() && provId == miProveedorId());
        allow create: if esInterno()
          || (invitadoALicitacion(licId) && provId == miProveedorId()
              && request.resource.data.proveedorUid == request.auth.uid
              && dentroDePlazo(licId));
        allow update: if esInterno()
          || (invitadoALicitacion(licId) && provId == miProveedorId()
              && request.resource.data.proveedorUid == request.auth.uid
              && ((resource.data.estado != 'Enviada' && dentroDePlazo(licId))
                  || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmacionCorreo'])));
        allow delete: if esInterno();
      }

      // Libro de obra: como el libro en papel, nadie edita ni borra una anotación (tampoco el administrador).
      // Cada anotación queda a nombre de la sesión que la escribió; los errores se corrigen con otra anotación.
      match /libroObra/{entradaId} {
        allow read: if esInterno();
        allow create: if esInterno() && request.resource.data.autorEmail == request.auth.token.email;
        allow update, delete: if false;
        match /fotos/{fotoId} {
          allow read, create: if esInterno();
          allow update, delete: if false;
        }
      }

      // Todo lo demás de la licitación (cotizaciones, estados de pago, envíos, etc.): solo personal interno.
      // Excluye las propuestas (abriría las ofertas selladas) y el libro de obra (permitiría editarlo).
      match /{sub}/{resto=**} {
        allow read, write: if esInterno() && sub != 'propuestas' && sub != 'libroObra';
      }
    }

    // Alerta de consultas pendientes de todas las licitaciones (consulta de grupo de colecciones).
    match /{ruta=**}/consultas/{consultaId} {
      allow read: if esInterno();
    }

    // Alerta de garantías por vencer de todas las licitaciones.
    match /{ruta=**}/garantias/{garantiaId} {
      allow read: if esInterno();
    }

    // Carga de trabajo de los proveedores: todos los invitados de todas las licitaciones en una sola lectura.
    match /{ruta=**}/invitados/{provId} {
      allow read: if esInterno();
    }

    // ── Proveedores: un proveedor solo lee la ficha de su propia empresa ───
    match /proveedores/{id} {
      allow read: if esInterno() || (esProveedor() && id == miProveedorId());
      allow write: if esInterno();
      match /{resto=**} {
        allow read, write: if esInterno();
      }
    }

    // ── Todo lo demás: solo personal interno ───────────────────────────────
    // (Las licitaciones y sus subcolecciones tienen sus propias reglas arriba: un comodín aquí abriría las
    // ofertas selladas, porque en Firebase basta que UNA regla permita el acceso.)
    match /{coleccion}/{document=**} {
      allow read, write: if esInterno() && coleccion != 'licitaciones' && coleccion != 'auditoria';
    }

    // Registro de cambios: cada entrada queda a nombre de quien la escribe y nadie la edita ni la borra.
    match /auditoria/{registroId} {
      allow read: if esInterno();
      allow create: if esInterno() && request.resource.data.usuario == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
